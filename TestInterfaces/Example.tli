inline HRESULT ICalcCb::Message ( _bstr_t Message ) {
    HRESULT _hr = raw_Message(Message);
    if (FAILED(_hr)) _com_issue_errorex(_hr, this, __uuidof(std::remove_reference_t<decltype(*this)>));
    return _hr;
}

